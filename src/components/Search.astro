---
// Replaces Starlight's Pagefind search (Pagefind indexes static HTML at build
// time; University pages are now rendered on request). Same button and dialog
// as Starlight; results come from /api/search (EmDash full-text search).
import { MAGNIFIER } from "./icons";
const t = Astro.locals.t;
---

<site-search class={Astro.props.class}>
  <button data-open-modal aria-label={t("search.label")} aria-keyshortcuts="Control+K">
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1em;" set:html={MAGNIFIER} />
    <span class="sl-hidden md:sl-block" aria-hidden="true">{t("search.label")}</span>
    <kbd class="sl-hidden md:sl-flex"><kbd>Ctrl</kbd><kbd>K</kbd></kbd>
  </button>

  <dialog style="padding:0" aria-label={t("search.label")}>
    <div class="dialog-frame sl-flex">
      <button data-close-modal class="sl-flex md:sl-hidden">{t("search.cancelLabel")}</button>
      <form role="search" class="search-form">
        <input type="search" name="q" placeholder={t("search.label")} autocomplete="off" aria-label={t("search.label")} />
      </form>
      <p class="search-status" aria-live="polite"></p>
      <ul class="search-results"></ul>
    </div>
  </dialog>
</site-search>

<script>
  class SiteSearch extends HTMLElement {
    connectedCallback() {
      const open = this.querySelector<HTMLButtonElement>("button[data-open-modal]")!;
      const close = this.querySelector<HTMLButtonElement>("button[data-close-modal]")!;
      const dialog = this.querySelector("dialog")!;
      const form = this.querySelector("form")!;
      const input = this.querySelector<HTMLInputElement>("input[name=q]")!;
      const list = this.querySelector<HTMLUListElement>(".search-results")!;
      const status = this.querySelector<HTMLParagraphElement>(".search-status")!;
      const show = () => {
        dialog.showModal();
        document.body.toggleAttribute("data-search-modal-open", true);
        input.focus();
      };
      const hide = () => dialog.close();
      form.addEventListener("submit", (e) => e.preventDefault());
      dialog.addEventListener("close", () => document.body.toggleAttribute("data-search-modal-open", false));
      open.addEventListener("click", show);
      close.addEventListener("click", hide);
      dialog.addEventListener("click", (e) => e.target === dialog && hide());
      if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
        const k = open.querySelector("kbd kbd");
        if (k) k.textContent = "⌘";
      }
      window.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          if (dialog.open) hide();
          else show();
        }
      });

      let timer: number | undefined;
      let seq = 0;
      input.addEventListener("input", () => {
        clearTimeout(timer);
        timer = window.setTimeout(async () => {
          const q = input.value.trim();
          const mine = ++seq;
          list.replaceChildren();
          if (q.length < 2) {
            status.textContent = "";
            return;
          }
          status.textContent = "Searching…";
          try {
            const r = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
            const data = await r.json();
            if (mine !== seq) return;
            const results: { title: string; url: string; snippet: string }[] = data.results ?? [];
            status.textContent = data.error ?? (results.length ? "" : `No results for “${q}”`);
            for (const res of results) {
              const li = document.createElement("li");
              const a = document.createElement("a");
              a.href = res.url;
              const title = document.createElement("span");
              title.className = "search-title";
              title.textContent = res.title;
              const snip = document.createElement("span");
              snip.className = "search-snippet";
              // EmDash already escapes the indexed text; escape again anyway and
              // allow back only the <mark> tags around matches.
              snip.innerHTML = String(res.snippet ?? "")
                .replace(/&(?!(amp|lt|gt|quot|#39);)/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/&lt;(\/?)mark&gt;/g, "<$1mark>");
              a.append(title, snip);
              li.append(a);
              list.append(li);
            }
          } catch {
            if (mine === seq) status.textContent = "Search is unavailable right now.";
          }
        }, 200);
      });
    }
  }
  customElements.define("site-search", SiteSearch);
</script>

<style>
  site-search {
    display: contents;
  }
  button[data-open-modal] {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    background-color: transparent;
    color: var(--sl-color-gray-1);
    cursor: pointer;
    height: 2.5rem;
    font-size: var(--sl-text-xl);
  }
  @media (min-width: 50rem) {
    button[data-open-modal] {
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      padding-inline-start: 0.75rem;
      padding-inline-end: 0.5rem;
      background-color: var(--sl-color-black);
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
      width: 100%;
      max-width: 22rem;
    }
    button[data-open-modal]:hover {
      border-color: var(--sl-color-gray-2);
      color: var(--sl-color-white);
    }
    button[data-open-modal] > :last-child {
      margin-inline-start: auto;
    }
  }
  button > kbd {
    border-radius: 0.25rem;
    font-size: var(--sl-text-2xs);
    gap: 0.25em;
    padding-inline: 0.375rem;
    background-color: var(--sl-color-gray-6);
  }
  kbd {
    font-family: var(--__sl-font);
  }
  dialog {
    margin: 0;
    background-color: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    box-shadow: var(--sl-shadow-lg);
  }
  dialog[open] {
    display: flex;
  }
  dialog::backdrop {
    background-color: var(--sl-color-backdrop-overlay);
    backdrop-filter: blur(0.25rem);
  }
  .dialog-frame {
    position: relative;
    overflow: auto;
    flex-direction: column;
    flex-grow: 1;
    gap: 1rem;
    padding: 1rem;
  }
  button[data-close-modal] {
    position: absolute;
    z-index: 1;
    align-items: center;
    align-self: flex-end;
    height: 3rem;
    padding: 0.25rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: var(--sl-color-text-accent);
  }
  .search-form input {
    width: calc(100% - 5rem);
    height: 3rem;
    padding-inline: 1rem;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
    background-color: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .search-status {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .search-status:empty {
    display: none;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .search-results a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .search-results a:hover,
  .search-results a:focus-visible {
    border-color: var(--sl-color-accent);
  }
  .search-title {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .search-snippet {
    font-size: var(--sl-text-sm);
  }
  .search-snippet :global(mark) {
    background-color: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
  @media (min-width: 50rem) {
    .search-form input {
      width: 100%;
    }
    dialog {
      margin: 4rem auto auto;
      border-radius: 0.5rem;
      width: 90%;
      max-width: 40rem;
      height: max-content;
      min-height: 15rem;
      max-height: calc(100% - 8rem);
    }
  }
</style>
