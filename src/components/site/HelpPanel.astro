---
// Home page: how to reach the eTop helpdesk, plus the main sections.
// Theme UI (data-parity-ignore), so it never changes page content checks.
interface Props {
  sections: { label: string; href: string; count?: number }[];
}
const { sections } = Astro.props;
---

<div class="help-panel not-content" data-parity-ignore>
  <section class="help-now" aria-labelledby="help-now-h">
    <h2 id="help-now-h">Need help right now?</h2>
    <p>Our helpdesk answers by phone and email.</p>
    <div class="help-actions">
      <a class="help-btn primary" href="tel:+19513980021">Call 951-398-0021</a>
      <a class="help-btn" href="mailto:helpdesk@etoptechnology.com">helpdesk@etoptechnology.com</a>
    </div>
  </section>
  <nav class="section-cards" aria-label="Browse University">
    <h2>Browse University</h2>
    <ul>
      {
        sections.map((s) => (
          <li>
            <a href={s.href}>
              <span class="label">{s.label}</span>
              {s.count ? <span class="count">{s.count} {s.count === 1 ? "page" : "pages"}</span> : null}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
